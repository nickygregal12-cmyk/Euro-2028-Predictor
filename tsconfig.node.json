{
  "compilerOptions": {
    // Stated, not inherited. TypeScript 6 turns `strict` on by default, so
    // every check below is already in force — but that makes the guarantee a
    // property of the pinned compiler major rather than of this repository.
    // Declaring it means a compiler change or a downgrade cannot quietly
    // switch off strictNullChecks and noImplicitAny with nothing failing.
    "strict": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "vite.analyze.config.ts", "vitest.storybook.config.ts"]
}
