# Public, repository-owned build switches for the authenticated application E2E.
#
# This file contains no credentials. The Browser E2E workflow supplies its
# disposable Supabase URL/keys and auto-login credentials separately. Node 22's
# --env-file loads these values into the Playwright process before its Vite
# webServer starts, so the application under test gets the same Football Hub
# route implementation that the shipping Hub build selects.
#
# Keep this list aligned with the release-owned Hub switches. The guard in
# tests/scripts/browserE2EWorkflow.test.ts and the browser assertion in
# e2e/shipping-vnext.spec.ts make a silent return to legacy fail CI.
VITE_SITE_VARIANT=hub
VITE_UI_SEASON_MATCH_PREDICTOR=true
VITE_UI_FOOTBALL_HUB_HOME=true
VITE_UI_FOOTBALL_HUB_MATCHES=true
VITE_UI_FOOTBALL_HUB_GAMES=true
VITE_UI_FOOTBALL_HUB_LEAGUES=true
VITE_UI_FOOTBALL_HUB_PLAYER_PROFILE=true
VITE_UI_FOOTBALL_HUB_DISCOVERY=true
VITE_UI_FOOTBALL_HUB_ACCOUNT=true
VITE_UI_FOOTBALL_HUB_LMS=true
VITE_UI_FOOTBALL_HUB_CHAMPIONSHIP=true
VITE_UI_FOOTBALL_HUB_PREDICTOR=true
