{
  "compilerOptions": {
    // Stated, not inherited. TypeScript 6 turns `strict` on by default, so
    // every check below is already in force — but that makes the guarantee a
    // property of the pinned compiler major rather than of this repository.
    // Declaring it means a compiler change or a downgrade cannot quietly
    // switch off strictNullChecks and noImplicitAny with nothing failing.
    "strict": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /**
     * An optional property means ABSENT, not "present and undefined". Without
     * this, `{ a: undefined }` satisfies `{ a?: string }`, so spreading a partial
     * object over a complete one can erase a field while the types say it cannot.
     */
    "exactOptionalPropertyTypes": true,

    /**
     * `array[i]` and `record[key]` are typed as if the index always exists.
     * Without this, a scoring or elimination read past the end of an array is
     * silently `undefined` at runtime while the type says it cannot be.
     */
    "noUncheckedIndexedAccess": true
  },
  "include": ["src", ".storybook"]
}
