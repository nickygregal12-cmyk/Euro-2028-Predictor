# Direct Postgres connection string for the AI Lab jobs.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the SESSION POOLER URI for GitHub Actions (IPv4 reachable).
# This uses the postgres superuser and therefore bypasses RLS: it must never
# be present anywhere the browser can reach it.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# Which project this run is pointed at. Guards against training against prod by accident.
AI_ENV=development

# The Odds API credential deliberately does not belong here. Hosted collection
# runs in Supabase Edge Functions and reads ODDS_API from Edge Function
# secrets. A local operator may export it in their shell for a one-off probe,
# but it must never be copied into this file or GitHub Actions.
# AI_ODDS_POLL is the Edge Function caller key, not an odds-provider key. The
# matching database-side value belongs in Vault as provider_poll_caller_key.

# Optional: override the monthly soft cap for a single run. Prefer changing
# ai.api_budget.soft_cap so the limit is shared by every job.
# ODDS_API_SOFT_CAP=17000
