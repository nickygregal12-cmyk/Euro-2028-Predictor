{
  "name": "euro2028-predictor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.22.2"
  },
  "scripts": {
    "prepare": "lefthook install || true",
    "dev": "vite",
    "prebuild": "node scripts/validate-netlify-environment.mjs && node scripts/validate-deployment-contract.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "lint:css": "stylelint \"src/**/*.css\"",
    "check:migration-timestamps": "node scripts/check-migration-timestamps.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "test:fixtures": "node scripts/check-fixtures.mjs",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config=playwright.auth.config.ts",
    "test:e2e:euro": "playwright test --config=playwright.euro.config.ts",
    "test:e2e:vnext": "playwright test --config=playwright.vnext.config.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "smoke:production": "node scripts/production-smoke.mjs",
    "reset:development": "node scripts/reset-development-seed.mjs",
    "smoke:production:browser": "playwright test --config=playwright.production.config.ts",
    "test:coverage:domain": "vitest run tests/domain --coverage",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "check:documentation-authorities": "node scripts/check-documentation-authorities.mjs",
    "check:dead-code": "knip --no-exit-code",
    "check:lighthouse": "node scripts/run-lighthouse.mjs",
    "generate:now": "node scripts/generate-now.mjs",
    "generate:types": "node scripts/generate-database-types.mjs",
    "notifications:workflows": "node scripts/list-notification-workflows.mjs",
    "check:now": "node scripts/generate-now.mjs --check",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:property": "vitest run tests/domain/calculateScore.property.test.ts",
    "test:mutation": "stryker run",
    "analyze:bundle": "npm run prebuild && tsc -b && vite build --config vite.analyze.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@sentry/react": "10.69.0",
    "@supabase/supabase-js": "^2.110.7",
    "@tanstack/react-query": "^5.101.4",
    "flag-icons": "^7.5.0",
    "framer-motion": "^13.0.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.28.0",
    "posthog-js": "^1.417.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.0",
    "recharts": "^3.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.62.1",
    "@storybook/react-vite": "^10.5.8",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "fast-check": "4.9.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.0",
    "lefthook": "^2.1.10",
    "msw": "2.15.0",
    "oxlint": "^1.71.0",
    "rollup-plugin-visualizer": "7.0.1",
    "storybook": "^10.5.8",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript": "~7.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
