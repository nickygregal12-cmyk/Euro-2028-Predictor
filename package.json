{
  "name": "euro2028-predictor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/validate-netlify-environment.mjs && node scripts/validate-deployment-contract.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "check:migration-timestamps": "node scripts/check-migration-timestamps.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "test:fixtures": "node scripts/check-fixtures.mjs",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config=playwright.auth.config.ts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "smoke:production": "node scripts/production-smoke.mjs",
    "reset:development": "node scripts/reset-development-seed.mjs",
    "smoke:production:browser": "playwright test --config=playwright.production.config.ts",
    "test:coverage:domain": "vitest run tests/domain --coverage",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "check:documentation-authorities": "node scripts/check-documentation-authorities.mjs",
    "check:dead-code": "knip --no-exit-code"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@sentry/react": "10.67.0",
    "@supabase/supabase-js": "^2.110.7",
    "flag-icons": "^7.5.0",
    "framer-motion": "^12.43.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.28.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "knip": "^6.31.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
