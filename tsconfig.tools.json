{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tools.tsbuildinfo",
    // Playwright specs, local fixture harnesses and seed scripts are Node
    // programs. Edge Functions declare the small Deno runtime surface they use
    // locally and otherwise share the same strict compiler contract.
    "types": ["node"]
  },
  // TypeScript sources only. The .mjs operational scripts alongside them are
  // plain JavaScript and have a separate checked/deferred inventory.
  "include": [
    "e2e",
    "production-smoke",
    "scripts/**/*.ts",
    "supabase/functions/**/*.ts",
    "playwright.config.ts",
    "playwright.auth.config.ts",
    "playwright.production.config.ts",
    "playwright.visual.config.ts",
    "playwright.euro.config.ts"
  ]
}
