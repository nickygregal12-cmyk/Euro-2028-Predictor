# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea

# Local Claude Code config (launch.json, settings.local.json) is machine-local.
# The agent definitions and the hook that enforces their Bash allowlists are
# repository content: local-only enforcement is not enforcement, because a
# fresh clone or the cloud conductor would get the agents without the gate.
.claude/*
!.claude/agents/
!.claude/hooks/
!.claude/settings.json
.claude/hooks/__pycache__/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables — never commit Supabase keys, passwords or secrets
.env
.env.*
!.env.example

# Production logical-backup staging — never commit sensitive Auth/data dumps
.production-backups/
production-backups/
*.backup.tar
*.backup.tar.gz
*.backup.tar.gz.age
*.backup.zip
*.backup.zip.gpg
# Playwright browser-test output
playwright-report/
playwright-report-vnext/
test-results/

# Coverage output (npm run test:coverage:domain)
coverage/

# Storybook build output (npm run build:storybook). A regenerated artefact, and
# large enough that committing it once buries every real change in the diff.
storybook-static/

# Raw generative-model concept output (Higgsfield and similar). Research only —
# never a production dependency (design-system §11.10). Retained evidence is
# converted to WebP and committed under docs/visual/evidence/concepts/.
creative-source/

# Lighthouse CI reports — generated evidence, regenerated by npm run check:lighthouse
.lighthouseci/

# Provider bake-off output (scripts/ops/provider-bakeoff.ts). Raw provider
# responses are licensed third-party data whose retention terms are the open
# Stage D question — never commit them.
provider-bakeoff/
.venv-ai/

# Graphify knowledge-graph working output stays disposable in normal branches.
# CI publishes portable snapshots to the dedicated graphify-navigation branch.
# See docs/ops/graphify-navigation.md.
graphify-out/

# On-demand engineering-tool reports and immutable external skill caches;
# regenerated/materialized rather than versioned and never repository authority.
.artifacts/
.agent-cache/
.stryker-tmp/
reports/mutation/

# Developer operating-system state. The configuration is versioned; indexes,
# local execution memory and optional visual-engine output are not authorities.
.serena/*
!.serena/project.yml
.beads/
lost-pixel/
