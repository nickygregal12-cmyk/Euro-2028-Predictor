# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea

# Local Claude Code config (launch.json etc.) — machine-local, not repo content
.claude/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables — never commit Supabase keys, passwords or secrets
.env
.env.*
!.env.example

# Production logical-backup staging — never commit sensitive Auth/data dumps
.production-backups/
production-backups/
*.backup.tar
*.backup.tar.gz
*.backup.tar.gz.age
*.backup.zip
*.backup.zip.gpg
# Playwright browser-test output
playwright-report/
test-results/

# Coverage output (npm run test:coverage:domain)
coverage/

# Storybook build output (npm run build:storybook). A regenerated artefact, and
# large enough that committing it once buries every real change in the diff.
storybook-static/

# Raw generative-model concept output (Higgsfield and similar). Research only —
# never a production dependency (design-system §11.10). Retained evidence is
# converted to WebP and committed under docs/visual/evidence/concepts/.
creative-source/

# Lighthouse CI reports — generated evidence, regenerated by npm run check:lighthouse
.lighthouseci/

# Provider bake-off output (scripts/ops/provider-bakeoff.ts). Raw provider
# responses are licensed third-party data whose retention terms are the open
# Stage D question — never commit them.
provider-bakeoff/
.venv-ai/

# Graphify navigation output. Keep only portable/shareable navigation artefacts
# in Git; caches, manifests, interpreter paths and other runner-local state stay
# disposable. See docs/ops/graphify-navigation.md.
graphify-out/*
!graphify-out/graph.json
!graphify-out/graph.html
!graphify-out/GRAPH_REPORT.md

# On-demand engineering-tool reports; regenerated rather than versioned.
.artifacts/
.stryker-tmp/
reports/mutation/
