# Copy to ops/metabase/.env and fill in locally. That file is gitignored.
#
# Every value here is a PLACEHOLDER NAME. Never commit a real password, a real
# connection string, or anything from a Supabase project that carries players.

# --- Metabase's own application database (local container only) ---
# Metabase stores its dashboards, questions and its own user accounts here.
# This is NOT the Predictor database and must never be pointed at it.
METABASE_APPDB_PASSWORD=choose-a-local-only-password

# --- The analytics connection, added through the Metabase UI ---
#
# These are documented here so the contract is written down. Do NOT put them in
# this file for anything beyond a disposable local database: enter them in the
# Metabase UI, which stores them encrypted in its own application database.
#
# The role is `metabase_readonly`, created by analytics-views.sql. It can
# SELECT from schema `analytics` and from nothing else.
#
# NEVER use:
#   * the Supabase service-role key or its `postgres` superuser;
#   * any role with write, DDL or `public` schema access;
#   * a Production connection string, unless a separate owner decision has
#     authorised read-only Production reporting and the role above is what is
#     actually being used.
#
# ANALYTICS_DB_HOST=db.<project-ref>.supabase.co
# ANALYTICS_DB_PORT=5432
# ANALYTICS_DB_NAME=postgres
# ANALYTICS_DB_USER=metabase_readonly
# ANALYTICS_DB_PASSWORD=set-out-of-band-never-here
# ANALYTICS_DB_SCHEMA=analytics
# ANALYTICS_DB_SSLMODE=require
